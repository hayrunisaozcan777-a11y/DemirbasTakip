@model IEnumerable<DemirbasTakip.Models.Kullanici>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>👥 Kullanıcı Yönetimi</h2>
        <a asp-action="Create" class="btn btn-primary">
            ➕ Yeni Kullanıcı Ekle
        </a>
    </div>

    @if (TempData["Basarili"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Basarili"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Kullanıcı Adı</th>
                            <th>Rol</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td><strong>@item.KullaniciAdi</strong></td>
                                <td>
                                    <span class="badge bg-secondary">@item.Rol</span>
                                </td>
                                <td>
                                    @if (item.AktifMi)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Pasif</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form asp-action="PasifYap" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm @(item.AktifMi ? "btn-outline-danger" : "btn-outline-success")">
                                            @(item.AktifMi ? "Pasif Yap" : "Aktif Yap")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>