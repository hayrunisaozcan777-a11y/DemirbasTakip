@model DemirbasTakip.ViewModels.KullaniciFormViewModel
@using DemirbasTakip.Models
@{
    ViewData["Title"] = "Yeni Kullanıcı Ekle";
}

<div class="container-fluid p-0">
    <h2 class="mb-4">➕ Yeni Kullanıcı Ekle</h2>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label asp-for="KullaniciAdi" class="form-label"></label>
                            <input asp-for="KullaniciAdi" class="form-control" />
                            <span asp-validation-for="KullaniciAdi" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Sifre" class="form-label"></label>
                            <input asp-for="Sifre" class="form-control" />
                            <span asp-validation-for="Sifre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Rol" class="form-label"></label>
                            <select asp-for="Rol" asp-items="Html.GetEnumSelectList<KullaniciRol>()" class="form-select"></select>
                            <span asp-validation-for="Rol" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-secondary">İptal</a>
                            <button type="submit" class="btn btn-success">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>