@model IEnumerable<DemirbasTakip.Models.Zimmet>
@{
    ViewData["Title"] = "Zimmet İşlemleri";
    var isAdmin = Context.Session.GetString("KullaniciRol") == "Admin";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Zimmet İşlemleri</h3>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">+ Yeni Zimmet</a>
    }
</div>

<div class="row g-2 mb-3">
    <div class="col-auto">
        <select name="demirbasId" class="form-select" id="demirbasSelect">
            <option value="">Tüm Demirbaşlar</option>
            @if (ViewBag.Demirbaslar != null)
            {
                foreach (var item in (SelectList)ViewBag.Demirbaslar)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <input type="text" id="zimmetAramaInput" value="@Context.Request.Query["personelAdi"]" class="form-control" placeholder="Personel veya demirbaş ara..." />
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-dark">Temizle</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle" id="zimmetTablosu">
            <thead>
                <tr>
                    <th>Personel</th>
                    <th>Demirbaş</th>
                    <th>Zimmet Tarihi</th>
                    <th>İade Tarihi</th>
                    <th>Not</th>
                    <th>Durum</th>
                    @if (isAdmin)
                    {
                        <th class="text-end">İşlemler</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var z in Model)
                {
                    <tr>
                        <td><strong>@z.Personel?.AdSoyad</strong></td>
                        <td>@z.Demirbas?.Ad</td>
                        <td>@z.ZimmetTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@(z.IadeTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                        <td>@(string.IsNullOrEmpty(z.Not) ? "-" : z.Not)</td>
                        <td>
                            @if (z.Durum == DemirbasTakip.Models.ZimmetDurumu.Aktif)
                            {
                                <span class="badge bg-success">Zimmetli</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">İade Edildi</span>
                            }
                        </td>
                        @if (isAdmin)
                        {
                            <td class="text-end">
                                <a asp-action="Tutanak" asp-route-id="@z.Id" target="_blank" class="btn btn-sm btn-outline-info">🖨️ Tutanak</a>
                                
                                @if (z.Durum == DemirbasTakip.Models.ZimmetDurumu.Aktif)
                                {
                                    <a asp-action="Iade" asp-route-id="@z.Id" class="btn btn-sm btn-outline-warning">İade Al</a>
                                }
                            </td>
                        }
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Kayıt bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('zimmetAramaInput').addEventListener('keyup', function () {
            let arananDeger = this.value.toLowerCase().trim();
            let satirlar = document.querySelectorAll('#zimmetTablosu tbody tr');

            satirlar.forEach(satir => {
                let satirMetni = satir.textContent.toLowerCase();
                if (satirMetni.includes(arananDeger)) {
                    satir.style.display = '';
                } else {
                    satir.style.display = 'none';
                }
            });
        });
    </script>
}