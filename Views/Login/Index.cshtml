@model DemirbasTakip.ViewModels.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Giriş Yap";
}

<div class="d-flex justify-content-center align-items-center" style="min-height:70vh;">
    <div class="card shadow-sm" style="width:380px;">
        <div class="card-body p-4">
            <h4 class="mb-3 text-center">Demirbaş Takip - Giriş</h4>
            <form asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="KullaniciAdi" class="form-label"></label>
                    <input asp-for="KullaniciAdi" class="form-control" autofocus />
                    <span asp-validation-for="KullaniciAdi" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <!-- Şifre Etiketi ve Şifremi Unuttum Bağlantısı -->
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Sifre" class="form-label mb-0"></label>
                        <a href="#" class="text-decoration-none small text-primary" data-bs-toggle="modal" data-bs-target="#sifremiUnuttumModal">
                            Şifremi Unuttum?
                        </a>
                    </div>
                    <input asp-for="Sifre" class="form-control" />
                    <span asp-validation-for="Sifre" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3">Giriş Yap</button>

                <!-- Yeni Kullanıcı Bağlantısı -->
                <div class="text-center">
                    <a asp-action="Register" class="text-decoration-none small text-muted">Yeni Kullanıcı</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Şifremi Unuttum Modal (Açılır Pencere) -->
<div class="modal fade" id="sifremiUnuttumModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">🔑 Şifremi Unuttum</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4">
                <p class="mb-0">
                    Şifrenizi unuttuysanız lütfen sistem yöneticiniz (<strong>Admin</strong>) ile iletişime geçerek şifrenizi sıfırlatın.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Anladım</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Kullanıcı adı ve Şifre input'larını yakala
            var kullaniciInput = document.querySelector('input[name="KullaniciAdi"]');
            var sifreInput = document.querySelector('input[name="Sifre"]');

            // Eğer kullanıcı adı doluysa imleci şifre alanına odakla
            if (kullaniciInput && kullaniciInput.value.trim() !== "") {
                sifreInput.focus();
            }
        });
    </script>
}