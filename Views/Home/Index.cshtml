@model DemirbasTakip.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Ana Sayfa - Gösterge Paneli";
}

<div class="container-fluid p-0">
    <h2 class="mb-4">📊 Demirbaş Takip Sistemi - Genel Durum</h2>

    <!-- İstatistik Kartları -->
    <div class="row mb-4">
        <div class="col-md-3">
            <a asp-controller="Personel" asp-action="Index" class="text-decoration-none">
                <div class="card text-white bg-primary mb-3 shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title">Aktif Personeller</h6>
                        <h2 class="card-text fw-bold">@Model.ToplamPersonelSayisi</h2>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Demirbas" asp-action="Index" class="text-decoration-none">
                <div class="card text-white bg-success mb-3 shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title">Aktif Demirbaşlar</h6>
                        <h2 class="card-text fw-bold">@Model.ToplamDemirbasSayisi</h2>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Zimmet" asp-action="Index" class="text-decoration-none">
                <div class="card text-white bg-info mb-3 shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title">Aktif Zimmetler</h6>
                        <h2 class="card-text fw-bold">@Model.AktifZimmetSayisi</h2>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Zimmet" asp-action="Index" class="text-decoration-none">
                <div class="card text-white bg-warning mb-3 shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title">Bugünkü Zimmetler</h6>
                        <h2 class="card-text fw-bold">@Model.BugunkuZimmetSayisi</h2>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Grafikler -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light"><strong>Kategoriye Göre Demirbaş Dağılımı</strong></div>
                <div class="card-body">
                    <canvas id="kategoriGrafik"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light"><strong>Zimmet Durumu</strong></div>
                <div class="card-body">
                    <canvas id="durumGrafik"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Son Zimmetler Tablosu -->
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="m-0 font-weight-bold text-dark">📋 Son Zimmetlenen Demirbaşlar</h5>
        </div>
        <div class="card-body">
            @if (Model.SonZimmetler != null && Model.SonZimmetler.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Personel</th>
                                <th>Demirbaş</th>
                                <th>Zimmet Tarihi</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var z in Model.SonZimmetler)
                            {
                                <tr>
                                    <td>@(z.Personel?.AdSoyad ?? "-")</td>
                                    <td>@(z.Demirbas?.Ad ?? "-")</td>
                                    <td>@z.ZimmetTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        @if (z.Durum == DemirbasTakip.Models.ZimmetDurumu.Aktif)
                                        {
                                            <span class="badge bg-success">Zimmetli</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">İade Edildi</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted m-0">Henüz gösterilecek bir zimmet kaydı bulunmuyor.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const kategoriCtx = document.getElementById('kategoriGrafik');
        new Chart(kategoriCtx, {
            type: 'pie',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.KategoriEtiketleri)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.KategoriSayilari)),
                    backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#6c757d', '#dc3545']
                }]
            }
        });

        const durumCtx = document.getElementById('durumGrafik');
        new Chart(durumCtx, {
            type: 'bar',
            data: {
                labels: ['Zimmetli', 'İade Edildi'],
                datasets: [{
                    label: 'Adet',
                    data: [@Model.ZimmetliSayisi, @Model.IadeEdilmisSayisi],
                    backgroundColor: ['#0dcaf0', '#6c757d']
                }]
            },
            options: {
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    </script>
}