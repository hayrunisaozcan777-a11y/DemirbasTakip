@model IEnumerable<DemirbasTakip.Models.Demirbas>
@{
    ViewData["Title"] = "Demirbaşlar";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Demirbaşlar</h3>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Demirbaş</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="arama" value="@ViewBag.Arama" class="form-control" placeholder="Ad veya kod ara..." />
    </div>
    <div class="col-auto">
        <select name="kategori" class="form-select">
            <option value="">Tüm Kategoriler</option>
            @foreach (var k in Enum.GetValues<DemirbasTakip.Models.DemirbasTuru>())
            {
                <option value="@k" selected="@(ViewBag.Kategori?.Equals(k) == true)">@k</option>
            }
        </select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-secondary">Filtrele</button></div>
</form>
<div class="card"><div class="card-body p-0">
<table class="table table-hover mb-0">
<thead><tr><th>Kod</th><th>Ad</th><th>Kategori</th><th>Seri No</th><th>Durum</th><th class="text-end">İşlemler</th></tr></thead>
<tbody>
@foreach (var d in Model)
{
<tr>
<td>@d.DemirbasKodu</td><td>@d.Ad</td><td>@d.Kategori</td><td>@d.SeriNo</td>
<td>@(d.AktifMi ? "Aktif" : "Pasif")</td>
<td class="text-end">
<a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
<a asp-action="Delete" asp-route-id="@d.Id" class="btn btn-sm btn-outline-danger">Sil</a>
</td>
</tr>
}
@if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">Kayıt bulunamadı.</td></tr> }
</tbody>
</table>
</div></div>