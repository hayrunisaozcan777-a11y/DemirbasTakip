@model DemirbasTakip.ViewModels.SayfalanmisListe<DemirbasTakip.Models.Demirbas>

@{
    ViewData["Title"] = "Demirbaşlar";
    var isAdmin = Context.Session.GetString("KullaniciRol") == "Admin";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Demirbaşlar</h3>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">+ Yeni Demirbaş</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" id="demirbasAramaInput" name="arama" value="@ViewBag.Arama" class="form-control" placeholder="Ad veya kod ara..." />
    </div>
    <div class="col-auto">
        <select name="kategori" class="form-select" onchange="this.form.submit()">
            <option value="">Tüm Kategoriler</option>
            @foreach (var k in Enum.GetValues<DemirbasTakip.Models.DemirbasTuru>())
            {
                <option value="@k" selected="@(ViewBag.Kategori?.Equals(k) == true)">@k</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="durum" class="form-select" onchange="this.form.submit()">
            <option value="">Tüm Durumlar</option>
            @foreach (var dur in Enum.GetValues<DemirbasTakip.Models.DemirbasDurum>())
            {
                <option value="@dur" selected="@(ViewBag.Durum?.Equals(dur) == true)">@dur</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrele</button>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle" id="demirbasTablosu">
            <thead>
                <tr>
                    <th>Kod</th>
                    <th>Ad</th>
                    <th>Kategori</th>
                    <th>Seri No</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Items)
                {
                    <tr>
                        <td><strong>@d.DemirbasKodu</strong></td>
                        <td>@d.Ad</td>
                        <td>@d.Kategori</td>
                        <td>@(string.IsNullOrEmpty(d.SeriNo) ? "-" : d.SeriNo)</td>
                        <td>
                            @switch (d.Durum)
                            {
                                case DemirbasTakip.Models.DemirbasDurum.Bosta:
                                    <span class="badge bg-success">Boşta</span>
                                    break;
                                case DemirbasTakip.Models.DemirbasDurum.Zimmette:
                                    <span class="badge bg-primary">Zimmette</span>
                                    break;
                                case DemirbasTakip.Models.DemirbasDurum.Tamirde:
                                    <span class="badge bg-warning text-dark">Tamirde / Arızalı</span>
                                    break;
                                case DemirbasTakip.Models.DemirbasDurum.Hurda:
                                    <span class="badge bg-danger">Hurda</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@d.Durum</span>
                                    break;
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-info">Detay</a>
                            @if (isAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@d.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Kayıt bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('demirbasAramaInput').addEventListener('input', function () {
            let arananDeger = this.value.toLowerCase().trim();
            let satirlar = document.querySelectorAll('#demirbasTablosu tbody tr');

            satirlar.forEach(satir => {
                let satirMetni = satir.textContent.toLowerCase();
                if (satirMetni.includes(arananDeger)) {
                    satir.style.display = '';
                } else {
                    satir.style.display = 'none';
                }
            });
        });
    </script>
}