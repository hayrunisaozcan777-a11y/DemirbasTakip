@model DemirbasTakip.Models.Demirbas
@{
    ViewData["Title"] = "Demirbaş Detayı & Zimmet Geçmişi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Demirbaş Detayı: @Model.Ad</h3>
    <a asp-action="Index" class="btn btn-outline-secondary">← Listeye Dön</a>
</div>

<!-- Demirbaş Kart Bilgileri -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0">Demirbaş Bilgileri</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3"><strong>Demirbaş Kodu:</strong> @Model.DemirbasKodu</div>
            <div class="col-md-3"><strong>Kategori:</strong> @Model.Kategori</div>
            <div class="col-md-3"><strong>Seri No:</strong> @(string.IsNullOrEmpty(Model.SeriNo) ? "-" : Model.SeriNo)</div>
            <div class="col-md-3">
                <strong>Durum:</strong>
                @switch (Model.Durum)
                {
                    case DemirbasTakip.Models.DemirbasDurum.Bosta:
                        <span class="badge bg-success">Boşta</span>
                        break;
                    case DemirbasTakip.Models.DemirbasDurum.Zimmette:
                        <span class="badge bg-primary">Zimmette</span>
                        break;
                    case DemirbasTakip.Models.DemirbasDurum.Tamirde:
                        <span class="badge bg-warning text-dark">Tamirde / Arızalı</span>
                        break;
                    case DemirbasTakip.Models.DemirbasDurum.Hurda:
                        <span class="badge bg-danger">Hurda</span>
                        break;
                }
            </div>
        </div>
    </div>
</div>

<!-- Zimmet Geçmişi (Audit Trail) -->
<div class="card">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0">📜 Zimmet Geçmişi (Audit Trail)</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Personel</th>
                    <th>Zimmet Tarihi</th>
                    <th>İade Tarihi</th>
                    <th>Not</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var z in Model.Zimmetler)
                {
                    <tr>
                        <td><strong>@z.Personel?.AdSoyad</strong></td>
                        <td>@z.ZimmetTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@(z.IadeTarihi.HasValue ? z.IadeTarihi.Value.ToString("dd.MM.yyyy HH:mm") : "-")</td>
                        <td>@(string.IsNullOrEmpty(z.Not) ? "-" : z.Not)</td>
                        <td>
                            @if (z.Durum == DemirbasTakip.Models.ZimmetDurumu.Aktif)
                            {
                                <span class="badge bg-primary">Aktif Zimmet</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">İade Edildi</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Zimmetler.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Bu demirbaşın henüz bir zimmet kaydı bulunmuyor.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>