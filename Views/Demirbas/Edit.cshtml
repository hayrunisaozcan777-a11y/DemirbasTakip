@model DemirbasTakip.Models.Demirbas
@{ ViewData["Title"] = "Demirbaş Düzenle"; }
<h3>Demirbaş Düzenle</h3>
<div class="card"><div class="card-body">
<form asp-action="Edit" method="post">
<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="DemirbasKodu" class="form-label"></label><input asp-for="DemirbasKodu" class="form-control" /></div>
<div class="mb-3"><label asp-for="Ad" class="form-label"></label><input asp-for="Ad" class="form-control" /></div>
<div class="mb-3"><label asp-for="Kategori" class="form-label"></label><select asp-for="Kategori" class="form-select" asp-items="Html.GetEnumSelectList<DemirbasTakip.Models.DemirbasTuru>()"></select></div>
<div class="mb-3"><label asp-for="SeriNo" class="form-label"></label><input asp-for="SeriNo" class="form-control" /></div>
<div class="form-check mb-3"><input asp-for="AktifMi" class="form-check-input" /><label asp-for="AktifMi" class="form-check-label"></label></div>
<button type="submit" class="btn btn-primary">Güncelle</button>
<a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>
</div></div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }