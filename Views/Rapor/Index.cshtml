@model IEnumerable<DemirbasTakip.Models.Zimmet>
@{
    ViewData["Title"] = "Raporlar";
}

<h3 class="mb-4">Zimmet Raporu</h3>

<div class="row g-2 mb-4">
    <div class="col-md-4">
        <label class="form-label">Personel Ara</label>
        <input type="text" id="personelAramaInput" class="form-control" placeholder="Personel adı yazın..." />
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="dashboard-card text-white ps-4 py-3" style="background-color:#6c757d;">
            <div class="small">Toplam Kayıt</div>
            <h3>@ViewBag.ToplamKayit</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dashboard-card text-white ps-4 py-3" style="background-color:#198754;">
            <div class="small">Zimmetli</div>
            <h3>@ViewBag.AktifSayisi</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dashboard-card text-white ps-4 py-3" style="background-color:#dc3545;">
            <div class="small">İade Edildi</div>
            <h3>@ViewBag.IadeSayisi</h3>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0" id="raporTablosu">
            <thead>
                <tr>
                    <th>Personel</th>
                    <th>Demirbaş</th>
                    <th>Zimmet Tarihi</th>
                    <th>İade Tarihi</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var z in Model)
                {
                    <tr>
                        <td>@z.Personel?.AdSoyad</td>
                        <td>@z.Demirbas?.Ad</td> <!-- Buradaki ş harfi s yapıldı -->
                        <td>@z.ZimmetTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@(z.IadeTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                        <td>
                            @if (z.Durum == DemirbasTakip.Models.ZimmetDurumu.Aktif)
                            {
                                <span class="badge bg-success">Zimmetli</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">İade Edildi</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Kayıt bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('personelAramaInput').addEventListener('keyup', function () {
            let arananDeger = this.value.toLowerCase().trim();
            let satirlar = document.querySelectorAll('#raporTablosu tbody tr');

            satirlar.forEach(satir => {
                let satirMetni = satir.textContent.toLowerCase();
                if (satirMetni.includes(arananDeger)) {
                    satir.style.display = '';
                } else {
                    satir.style.display = 'none';
                }
            });
        });
    </script>
}