@model DemirbasTakip.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h3 class="mb-4">Dashboard</h3>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="dashboard-card" style="background-color:#0d6efd;">
            <div class="small">Toplam Personel</div>
            <h3>@Model.ToplamPersonelSayisi</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card" style="background-color:#198754;">
            <div class="small">Toplam Kaynak</div>
            <h3>@Model.ToplamKaynakSayisi</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card" style="background-color:#fd7e14;">
            <div class="small">Aktif Rezervasyon</div>
            <h3>@Model.AktifRezervasyonSayisi</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card" style="background-color:#6f42c1;">
            <div class="small">Bugünkü Rezervasyon</div>
            <h3>@Model.BugunkuRezervasyonSayisi</h3>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <strong>Son Rezervasyonlar</strong>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Personel</th>
                    <th>Kaynak</th>
                    <th>Başlangıç</th>
                    <th>Bitiş</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.SonRezervasyonlar)
                {
                    <tr>
                        <td>@r.Personel?.AdSoyad</td>
                        <td>@r.Kaynak?.Ad</td>
                        <td>@r.BaslangicZamani.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@r.BitisZamani.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (r.Durum == DemirbasTakip.Models.RezervasyonDurumu.Aktif)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">İptal Edildi</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.SonRezervasyonlar.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Henüz rezervasyon yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>