@model IEnumerable<DemirbasTakip.Models.Rezervasyon>
@{
    ViewData["Title"] = "Rezervasyonlar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Rezervasyonlar</h3>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Rezervasyon</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="kaynakId" class="form-select" asp-items="ViewBag.Kaynaklar">
            <option value="">Tüm Kaynaklar</option>
        </select>
    </div>
    <div class="col-auto">
        <select name="personelId" class="form-select" asp-items="ViewBag.Personeller">
            <option value="">Tüm Personel</option>
        </select>
    </div>
    <div class="col-auto">
        <input type="date" name="tarih" value="@ViewBag.Tarih" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrele</button>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-dark">Temizle</a>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Personel</th>
                    <th>Kaynak</th>
                    <th>Başlangıç</th>
                    <th>Bitiş</th>
                    <th>Açıklama</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>