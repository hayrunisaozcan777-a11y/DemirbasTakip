@model IEnumerable<DemirbasTakip.Models.Rezervasyon>
@{
    ViewData["Title"] = "Rezervasyonlar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Rezervasyonlar</h3>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Rezervasyon</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="kaynakId" class="form-select" asp-items="ViewBag.Kaynaklar">
            <option value="">Tüm Kaynaklar</option>
        </select>
    </div>
    <div class="col-auto">
        <select name="personelId" class="form-select" asp-items="ViewBag.Personeller">
            <option value="">Tüm Personel</option>
        </select>
    </div>
    <div class="col-auto">
        <input type="date" name="tarih" value="@ViewBag.Tarih" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrele</button>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-dark">Temizle</a>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Personel</th>
                    <th>Kaynak</th>
                    <th>Başlangıç</th>
                    <th>Bitiş</th>
                    <th>Açıklama</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Personel?.AdSoyad</td>
                        <td>@r.Kaynak?.Ad</td>
                        <td>@r.BaslangicZamani.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@r.BitisZamani.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@r.Aciklama</td>
                        <td>
                            @if (r.Durum == DemirbasTakip.Models.RezervasyonDurumu.Aktif)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">İptal Edildi</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (r.Durum == DemirbasTakip.Models.RezervasyonDurumu.Aktif)
                            {
                                <a asp-action="Iptal" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger">İptal Et</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Kayıt bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>