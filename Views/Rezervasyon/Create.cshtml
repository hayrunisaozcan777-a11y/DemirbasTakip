@model DemirbasTakip.ViewModels.RezervasyonFormViewModel
@{
    ViewData["Title"] = "Yeni Rezervasyon";
}

<h3>Yeni Rezervasyon Oluştur</h3>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="PersonelId" class="form-label"></label>
                <select asp-for="PersonelId" class="form-select" asp-items="Model.PersonelListesi">
                    <option value="">-- Personel Seçiniz --</option>
                </select>
                <span asp-validation-for="PersonelId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="KaynakId" class="form-label"></label>
                <select asp-for="KaynakId" class="form-select" asp-items="Model.KaynakListesi">
                    <option value="">-- Kaynak Seçiniz --</option>
                </select>
                <span asp-validation-for="KaynakId" class="text-danger"></span>
                <div class="form-text">Sistem, seçtiğiniz kaynağın çakışan bir rezervasyonu olup olmadığını otomatik kontrol eder.</div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="BaslangicZamani" class="form-label"></label>
                    <input asp-for="BaslangicZamani" class="form-control" type="datetime-local" />
                    <span asp-validation-for="BaslangicZamani" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="BitisZamani" class="form-label"></label>
                    <input asp-for="BitisZamani" class="form-control" type="datetime-local" />
                    <span asp-validation-for="BitisZamani" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Aciklama" class="form-label"></label>
                <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Aciklama" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Rezervasyon Oluştur</button>
            <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}