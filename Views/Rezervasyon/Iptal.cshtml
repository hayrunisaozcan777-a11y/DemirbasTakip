@model DemirbasTakip.Models.Rezervasyon
@{
    ViewData["Title"] = "Rezervasyon İptal";
}

<h3>Rezervasyon İptal Et</h3>

<div class="card">
    <div class="card-body">
        <p>Bu rezervasyonu iptal etmek istediğinize emin misiniz?</p>

        <dl class="row">
            <dt class="col-sm-3">Personel</dt>
            <dd class="col-sm-9">@Model.Personel?.AdSoyad</dd>

            <dt class="col-sm-3">Kaynak</dt>
            <dd class="col-sm-9">@Model.Kaynak?.Ad</dd>

            <dt class="col-sm-3">Başlangıç</dt>
            <dd class="col-sm-9">@Model.BaslangicZamani.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Bitiş</dt>
            <dd class="col-sm-9">@Model.BitisZamani.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Açıklama</dt>
            <dd class="col-sm-9">@Model.Aciklama</dd>
        </dl>

        <form asp-action="Iptal" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Evet, İptal Et</button>
            <a asp-action="Index" class="btn btn-secondary">Geri Dön</a>
        </form>
    </div>
</div>