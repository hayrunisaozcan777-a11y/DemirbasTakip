@model IEnumerable<DemirbasTakip.Models.Kaynak>
@{
    ViewData["Title"] = "Kaynaklar";

    string TurIkon(DemirbasTakip.Models.KaynakTuru tur) => tur switch
    {
        DemirbasTakip.Models.KaynakTuru.ToplantiOdasi => "🏢",
        DemirbasTakip.Models.KaynakTuru.Projeksiyon => "🎥",
        DemirbasTakip.Models.KaynakTuru.Arac => "🚗",
        DemirbasTakip.Models.KaynakTuru.DigerEkipman => "🛠️",
        _ => "📦"
    };

    string TurRenk(DemirbasTakip.Models.KaynakTuru tur) => tur switch
    {
        DemirbasTakip.Models.KaynakTuru.ToplantiOdasi => "primary",
        DemirbasTakip.Models.KaynakTuru.Projeksiyon => "warning",
        DemirbasTakip.Models.KaynakTuru.Arac => "success",
        DemirbasTakip.Models.KaynakTuru.DigerEkipman => "secondary",
        _ => "dark"
    };

    string TurAdi(DemirbasTakip.Models.KaynakTuru tur)
    {
        var memberInfo = typeof(DemirbasTakip.Models.KaynakTuru).GetMember(tur.ToString());
        var attr = memberInfo[0].GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false);
        return attr.Length > 0 ? ((System.ComponentModel.DataAnnotations.DisplayAttribute)attr[0]).Name ?? tur.ToString() : tur.ToString();
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Kaynaklar (Oda / Ekipman)</h3>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Kaynak</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="arama" value="@ViewBag.Arama" class="form-control" placeholder="Kaynak adı ara..." />
    </div>
    <div class="col-auto">
        <select name="tur" class="form-select">
            <option value="">Tüm Türler</option>
            @foreach (var t in Enum.GetValues<DemirbasTakip.Models.KaynakTuru>())
            {
                <option value="@t" selected="@(ViewBag.Tur?.Equals(t) == true)">@TurAdi(t)</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrele</button>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>Tür</th>
                    <th>Kapasite</th>
                    <th>Konum</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model)
                {
                    <tr>
                        <td>@k.Ad</td>
                        <td>
                            <span class="badge bg-@TurRenk(k.Tur)">@TurIkon(k.Tur) @TurAdi(k.Tur)</span>
                        </td>
                        <td>@k.Kapasite</td>
                        <td>@k.Konum</td>
                        <td>
                            @if (k.AktifMi)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@k.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@k.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Kayıt bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>