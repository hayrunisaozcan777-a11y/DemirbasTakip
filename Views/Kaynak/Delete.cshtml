@model DemirbasTakip.Models.Kaynak
@{
    ViewData["Title"] = "Kaynak Sil";
}

<h3>Kaynak Sil</h3>

<div class="card">
    <div class="card-body">
        @if (!(bool)ViewBag.SilinebilirMi)
        {
            <div class="alert alert-warning">
                Bu kaynağın <strong>aktif rezervasyonu</strong> bulunduğu için silinemez.
                Önce ilgili rezervasyonların iptal edilmesi gerekir.
            </div>
        }
        else
        {
            <p>Bu kaynağı silmek istediğinize emin misiniz?</p>
        }

        <dl class="row">
            <dt class="col-sm-3">Ad</dt>
            <dd class="col-sm-9">@Model.Ad</dd>
            <dt class="col-sm-3">Tür</dt>
            <dd class="col-sm-9">@Model.Tur</dd>
            <dt class="col-sm-3">Konum</dt>
            <dd class="col-sm-9">@Model.Konum</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            @if ((bool)ViewBag.SilinebilirMi)
            {
                <button type="submit" class="btn btn-danger">Evet, Sil</button>
            }
            <a asp-action="Index" class="btn btn-secondary">Geri Dön</a>
        </form>
    </div>
</div>